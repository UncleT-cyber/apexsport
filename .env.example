APEXSPORT_ENV=development
APEXSPORT_SECRET_KEY=change-me
APEXSPORT_DEBUG=true
APEXSPORT_LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://apexsport:apexsport@localhost:5432/apexsport
REDIS_URL=redis://localhost:6379/0

# Provider keys (server-side only)
SPORTMONKS_API_KEY=
API_FOOTBALL_API_KEY=
SPORTRADAR_API_KEY=
THE_ODDS_API_KEY=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=
GEMINI_API_KEY=

# Supabase (Auth/Database) — set for production Render deployment
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Frontend — Render Static Site env (VITE_ prefix, build-time)
VITE_API_URL=https://api.apexsports.example.com
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# CORS — comma-separated allowed origins (Render frontend URL)
APEXSPORT_CORS_ORIGINS=https://apexsports.example.com

# Scanner
SCAN_INTERVAL_SECONDS=300
